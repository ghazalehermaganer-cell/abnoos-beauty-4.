<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>پنل مدیریت سالن آبنوس</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0; padding: 25px; font-family: Tahoma, Arial, sans-serif;
      background: #111; color: #f5f5f5;
    }
    .container { max-width: 1200px; margin: 0 auto; }
    h1, h2 { color: #d6b36a; }
    .login-box {
      max-width: 420px; margin: 70px auto; padding: 30px;
      background: #1d1d1d; border: 1px solid #8e713c; border-radius: 15px;
    }
    input {
      width: 100%; padding: 13px; margin: 12px 0; border: 1px solid #555;
      border-radius: 8px; background: #111; color: white; font-size: 16px;
    }
    button {
      border: 0; border-radius: 8px; padding: 11px 17px; cursor: pointer;
      font-family: inherit; font-size: 14px;
    }
    button:disabled { opacity: .6; cursor: wait; }
    .gold-button {
      width: 100%; background: #d6b36a; color: #111; font-weight: bold;
    }
    .delete-button { background: #a93232; color: white; }
    .logout-button { background: #333; color: white; }
    .top-bar {
      display: flex; align-items: center; justify-content: space-between;
      gap: 15px; margin-bottom: 25px;
    }
    .message, .error {
      padding: 13px; margin: 15px 0; border-radius: 8px;
    }
    .message { background: #183d27; color: #b8f5ca; }
    .error { background: #4a2020; color: #ffd0d0; }
    .table-wrap { overflow-x: auto; border: 1px solid #444; border-radius: 12px; }
    table {
      width: 100%; min-width: 950px; border-collapse: collapse; background: #1b1b1b;
    }
    th, td {
      padding: 13px 11px; border-bottom: 1px solid #383838;
      text-align: right; vertical-align: top;
    }
    th { background: #292316; color: #e2c27d; }
    tr:hover td { background: #242424; }
    .empty { padding: 30px; text-align: center; color: #ccc; }
    .count { color: #ccc; margin-bottom: 15px; }
    .hidden { display: none !important; }
    @media (max-width: 600px) {
      body { padding: 12px; }
      .top-bar { align-items: flex-start; flex-direction: column; }
    }
  </style>
</head>
<body>
<div class="container">
  <section id="loginView" class="login-box">
    <h1>مدیریت سالن آبنوس</h1>
    <p>برای مشاهده رزروها، رمز ادمین را وارد کن.</p>
    <div id="loginError" class="error hidden" role="alert"></div>
    <form id="loginForm">
      <input id="passwordInput" type="password" placeholder="رمز ادمین"
             required autocomplete="current-password">
      <button id="loginButton" class="gold-button" type="submit">ورود به پنل</button>
    </form>
  </section>

  <section id="adminView" class="hidden">
    <div class="top-bar">
      <div>
        <h1>پنل مدیریت آبنوس</h1>
        <p>مشاهده و مدیریت رزروهای مشتریان</p>
      </div>
      <div>
        <button id="refreshButton" class="logout-button" type="button">به‌روزرسانی</button>
        <button id="logoutButton" class="logout-button" type="button">خروج از پنل</button>
      </div>
    </div>
    <div id="notice" class="message hidden" role="status"></div>
    <div id="adminError" class="error hidden" role="alert"></div>
    <div class="count">تعداد رزروهای ثبت‌شده: <strong id="bookingCount">۰</strong></div>
    <div id="emptyState" class="empty hidden">هنوز رزروی ثبت نشده است.</div>
    <div id="tableWrap" class="table-wrap hidden">
      <table>
        <thead>
          <tr>
            <th>ردیف</th><th>نام و نام خانوادگی</th><th>شماره موبایل</th>
            <th>تاریخ شمسی</th><th>ساعت</th><th>خدمت</th>
            <th>توضیحات</th><th>عملیات</th>
          </tr>
        </thead>
        <tbody id="bookingRows"></tbody>
      </table>
    </div>
  </section>
</div>

<script>
  const API_BASE = "https://abnoos-api.ghazaleh-ermagan-er.workers.dev";
  let adminPassword = "";

  const $ = (id) => document.getElementById(id);

  function show(elementId, message) {
    const el = $(elementId);
    el.textContent = message;
    el.classList.remove("hidden");
  }
  function hide(elementId) {
    $(elementId).classList.add("hidden");
  }
  function escapeHtml(value) {
    return String(value ?? "").replace(/[&<>"']/g, ch => ({
      "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
    })[ch]);
  }
  function toJalali(gregorianDate) {
    const parts = String(gregorianDate).split("-");
    if (parts.length !== 3) return gregorianDate;
    const date = new Date(Date.UTC(
      Number(parts[0]), Number(parts[1]) - 1, Number(parts[2]), 12
    ));
    return new Intl.DateTimeFormat("fa-IR-u-ca-persian-nu-latn", {
      year: "numeric", month: "2-digit", day: "2-digit",
      timeZone: "UTC"
    }).format(date);
  }
  async function apiRequest(path, options = {}) {
    const headers = new Headers(options.headers || {});
    headers.set("X-Admin-Password", adminPassword);
    if (options.body) headers.set("Content-Type", "application/json");
    const response = await fetch(API_BASE + path, { ...options, headers });
    let data;
    try { data = await response.json(); }
    catch { throw new Error("پاسخ سرور قابل خواندن نیست."); }
    if (!response.ok) throw new Error(data.error || "ارتباط با سرور ناموفق بود.");
    return data;
  }

  async function loadBookings() {
    hide("adminError");
    hide("notice");
    $("refreshButton").disabled = true;
    try {
      const data = await apiRequest("/api/admin/bookings");
      renderBookings(Array.isArray(data.bookings) ? data.bookings : []);
    } catch (error) {
      show("adminError", error.message);
      if (error.message.includes("غیرمجاز")) logout();
    } finally {
      $("refreshButton").disabled = false;
    }
  }

  function renderBookings(bookings) {
    $("bookingCount").textContent = new Intl.NumberFormat("fa-IR").format(bookings.length);
    $("bookingRows").innerHTML = "";
    $("emptyState").classList.toggle("hidden", bookings.length !== 0);
    $("tableWrap").classList.toggle("hidden", bookings.length === 0);

    for (const booking of bookings) {
      const row = document.createElement("tr");
      const date = toJalali(booking.booking_date);
      const time = String(booking.booking_time || "").slice(0, 5);
      row.innerHTML = `
        <td>${escapeHtml(booking.id)}</td>
        <td>${escapeHtml(booking.customer_name)}</td>
        <td>${escapeHtml(booking.phone)}</td>
        <td>${escapeHtml(date)}</td>
        <td>${escapeHtml(time)}</td>
        <td>${escapeHtml(booking.service)}</td>
        <td>${escapeHtml(booking.note || "—")}</td>
        <td><button class="delete-button" type="button"
            data-id="${escapeHtml(booking.id)}">حذف رزرو</button></td>`;
      $("bookingRows").appendChild(row);
    }
  }

  $("loginForm").addEventListener("submit", async (event) => {
    event.preventDefault();
    hide("loginError");
    adminPassword = $("passwordInput").value;
    $("loginButton").disabled = true;
    try {
      const data = await apiRequest("/api/admin/bookings");
      $("loginView").classList.add("hidden");
      $("adminView").classList.remove("hidden");
      renderBookings(Array.isArray(data.bookings) ? data.bookings : []);
      $("passwordInput").value = "";
    } catch (error) {
      adminPassword = "";
      show("loginError", error.message === "دسترسی غیرمجاز است"
        ? "رمز عبور اشتباه است." : error.message);
    } finally {
      $("loginButton").disabled = false;
    }
  });

  $("bookingRows").addEventListener("click", async (event) => {
    const button = event.target.closest("button[data-id]");
    if (!button) return;
    const id = button.dataset.id;
    if (!confirm("آیا از حذف این رزرو مطمئنی؟ ساعت آن دوباره آزاد می‌شود.")) return;

    button.disabled = true;
    hide("adminError");
    hide("notice");
    try {
      const result = await apiRequest("/api/admin/bookings?id=" + encodeURIComponent(id), {
        method: "DELETE"
      });
      if (result.success) {
        show("notice", "رزرو با موفقیت حذف شد. ساعت آن دوباره آزاد است.");
        await loadBookings();
      } else {
        show("adminError", result.message || "حذف رزرو انجام نشد.");
        button.disabled = false;
      }
    } catch (error) {
      show("adminError", error.message);
      button.disabled = false;
    }
  });

  $("refreshButton").addEventListener("click", loadBookings);
  $("logoutButton").addEventListener("click", logout);

  function logout() {
    adminPassword = "";
    $("passwordInput").value = "";
    $("adminView").classList.add("hidden");
    $("loginView").classList.remove("hidden");
    hide("adminError");
    hide("notice");
  }
</script>
</body>
</html>
